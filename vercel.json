{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node -e \"require('fs').cpSync('public/assets','dist/assets',{recursive:true})\"",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{public,src,config}/**"
    }
  },
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/api/index.php" }
  ]
}
